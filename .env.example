# SIGNAL environment — copy to .env and fill real values. Never commit .env.
# All secrets live here; application.properties reads from these vars.

# Backend
DB_URL=jdbc:postgresql://localhost:5432/signal
DB_USER=signal
DB_PASSWORD=signal
CORS_ORIGIN=http://localhost:3000

# AI Gateway (Phase 5) — key lives ONLY here, never in code
# AI_PROVIDER=deepseek
# AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# JWT — secret must be >=32 chars, generated once per environment
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# AI gateway (Phase 5.2) — key NEVER hardcoded
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# Embeddings (Phase 6 K2) — may use a DIFFERENT provider than chat.
# Leave blank to reuse the chat coordinates above (single-provider setups need no config).
# ai.embedding-dimensions MUST match the vector(…) schema (V17 = 1024).
# Example: chat on ModelScope + embeddings on Alibaba DashScope
#   AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   AI_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1024

# Re-ranking (Phase 6) — cross-encoder precision pass after hybrid retrieval.
# Optional: leave blank and the no-op provider is used (retrieval order is kept as-is).
# Blank base-url / api-key fall back to the embedding coordinates above.
# NB DashScope serves re-ranking from its NATIVE path (/api/v1/services/rerank/…),
# NOT /compatible-mode/v1 — so the base URL is set explicitly when using DashScope:
#   AI_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
#   AI_RERANK_MODEL=qwen3.7-text-rerank
AI_RERANK_BASE_URL=
AI_RERANK_MODEL=
AI_RERANK_API_KEY=

# Ingestion (Phase 4)
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_MAX_ITEMS=5
INGESTION_HTTP_TIMEOUT=8000
INGESTION_MAX_RESPONSE_SIZE=5242880
INGESTION_MAX_FILE_SIZE=10485760

# Sync-path auto-pipeline caps — per sync request. Every new item costs provider
# round-trips (understanding; one embedding per chunk) on the request thread, so the
# batch is bounded. The remainder is covered by POST /api/v1/knowledge/reindex
# (idempotent). 0 disables the step on the request path.
AUTO_UNDERSTAND_LIMIT=20
AUTO_CHUNK_LIMIT=20

# Credential-endpoint rate limiting (429 + Retry-After). In-process sliding window,
# per client address. 0 disables one rule; RATE_LIMIT_ENABLED=false disables all
# (load tests only). Set RATE_LIMIT_TRUST_FORWARDED_FOR=true only behind a proxy you
# control — the header is client-controlled otherwise.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=30
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_TRUST_FORWARDED_FOR=false
RATE_LIMIT_MAX_TRACKED_KEYS=20000

# Agent (Phase 7) — how many steps the planner may emit, and the ceiling the request
# body's maxSteps is clamped to.
AGENT_MAX_STEPS=6
AGENT_MAX_PLAN_STEPS=10

# Automation (Phase 8) — the scheduler sweeps due jobs, retries with linear backoff,# and dead-letters a job once it hits AUTOMATION_MAX_ATTEMPTS consecutive failures
# (which also raises a JOB_FAILED notification and disables the job until a manual retry).
# Set AUTOMATION_ENABLED=false to switch the whole scheduler off.
AUTOMATION_ENABLED=true
AUTOMATION_TICK_MS=60000
AUTOMATION_MAX_ATTEMPTS=3
AUTOMATION_RETRY_BACKOFF_MINUTES=5

# Daily brief (Phase 8) — how many top signals the brief is allowed to draw from.
BRIEF_MAX_SIGNALS=10

# Outbound notification webhook (Phase 9-N1) — push alerts to a phone via an IM bot.
# NOTIFY_WEBHOOK_URL is the bot's incoming-webhook address; blank = channel disabled
# (the in-app inbox is the source of truth either way).
# NOTIFY_WEBHOOK_TYPE is the payload dialect: feishu | wecom | dingtalk | json
# Create the webhook in Feishu/WeCom/DingTalk: group settings → bots → add custom bot
#   → copy its Webhook address here.
# NOTIFY_WEBHOOK_SECRET is only for dingtalk bots created with a sign key (optional).
# NOTIFY_WEBHOOK_TYPES is a comma list of pushed notification types
# (DAILY_BRIEF / JOB_FAILED / IMPORTANT_SIGNAL).
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TYPE=feishu
# NOTIFY_WEBHOOK_SECRET=
# NOTIFY_WEBHOOK_TYPES=DAILY_BRIEF,JOB_FAILED,IMPORTANT_SIGNAL
# NOTIFY_WEBHOOK_TIMEOUT_MS=10000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
