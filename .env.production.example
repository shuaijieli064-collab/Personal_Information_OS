# SIGNAL production configuration — copy to .env.prod and fill real values.
#   cp .env.production.example .env.prod
# Then run:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Never commit .env.prod. Never reuse a dev .env here (different secrets, different values).

# ── Site (the ONE public address) ─────────────────────────────────────────────
# A real domain with TLS:      https://signal.example.com
# LAN / IP, HTTP only:         http://192.168.1.10        (port 80)
# The value has THREE simultaneous roles, keep them consistent:
#   1. Caddy's site address (deploy/Caddyfile {$SITE_ADDRESS}) — a scheme-less
#      port works too, but scheme + domain is the clearest.
#   2. Baked into the frontend build (NEXT_PUBLIC_API_URL) — changing it later
#      requires a frontend image REBUILD (it cannot come from runtime env).
#   3. Backend CORS origin — same origin anyway, set for defense in depth.
SITE_ADDRESS=https://signal.example.com

# ── Database ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 24  (or any long password tool)
# Keep DB_USER=signal unless you have a reason — pg_isready healthcheck uses it.
DB_USER=signal
DB_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48   (must be >= 32 chars; changing it logs out all users)
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900
# 7 days. Note (2026-10-22): tokens live in localStorage by design for now (single-user,
# trusted devices). Do not expose this site to strangers-writable networks.
JWT_REFRESH_EXPIRATION=604800

# ── Rate limiting ────────────────────────────────────────────────────────────
# Defaults from .env.example are fine; TRUST_FORWARDED_FOR is forced "true" in
# docker-compose.prod.yml because caddy is our proxy (do NOT set it to true when
# the backend is exposed directly).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=30
RATE_LIMIT_REFRESH_PER_MINUTE=30

# ── AI gateway — chat / embeddings / rerank ──────────────────────────────────
# Chat provider (OpenAI-compatible). Without a key the app falls back to the
# deterministic MockAIProvider — every AI feature degrades to heuristics, and
# nothing crashes (verified Phase 5–8 behaviour).
AI_PROVIDER=openai
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_API_KEY=
AI_TIMEOUT_MS=20000

# Embeddings may use a DIFFERENT provider than chat. Blank = reuse chat coords.
# AI_EMBEDDING_DIMENSIONS must equal the vector(…) schema (Flyway V17: 1024).
# DashScope supports 256/512/768/1024/1536/2048/2560.
AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
AI_EMBEDDING_DIMENSIONS=1024

# Rerank (cross-encoder, optional). Blank = NoopRerankProvider, retrieval order kept.
# NB DashScope serves rerank from its NATIVE path, not /compatible-mode:
AI_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AI_RERANK_MODEL=qwen3.7-text-rerank
AI_RERANK_API_KEY=

# ── Automation (Phase 8) ─────────────────────────────────────────────────────
# On a 2-core host a 60s tick is cheap and keeps syncs feeling fresh.
AUTOMATION_ENABLED=true
AUTOMATION_TICK_MS=60000
AUTOMATION_MAX_ATTEMPTS=3
AUTOMATION_RETRY_BACKOFF_MINUTES=5

# ── Outbound notification webhook (Phase 9-N1) ──────────────────────────────
# Push alerts to your phone via an IM group bot — the brief, dead-lettered jobs and
# important signals no longer require the web app to be open. Get the URL from your
# platform: Feishu/WeCom/DingTalk group → bots → add custom bot → Webhook address.
# Dialect options: feishu | wecom | dingtalk | json (plain object for anything else).
# Blank URL (default) disables the channel; the in-app inbox always keeps working.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TYPE=feishu
# NOTIFY_WEBHOOK_SECRET=        # dingtalk sign key only; leave blank otherwise
# NOTIFY_WEBHOOK_TYPES=DAILY_BRIEF,JOB_FAILED,IMPORTANT_SIGNAL
# NOTIFY_WEBHOOK_TIMEOUT_MS=10000

# ── Backend JVM memory (2 GB host budget) ────────────────────────────────────
# postgres ~300 MB + JVM ~800 MB + frontend ~350 MB + caddy ~30 MB ≈ 1.5 GB.
# If you raise JAVA_OPTS past this, add swap FIRST — ExitOnOutOfMemoryError makes
# the container die-and-restart instead of limping.
JAVA_OPTS=-Xms128m -Xmx700m -XX:+ExitOnOutOfMemoryError
